# Copy to /home/deploy/opt/wallet/deploy/.env on the VPS (chmod 600). Never commit the real file.
NODE_ENV=production
ENV_FILE=.env
POSTGRES_PASSWORD=<openssl rand -hex 24>
BETTER_AUTH_SECRET=<openssl rand -hex 32>
BETTER_AUTH_URL=https://wallet.samtama.lol
TRUSTED_ORIGINS=https://wallet.samtama.lol
# 8081 while the v1 Go container still owns 8080; switch to 8080 at cutover.
API_PORT=8081
MIN_CLIENT_ANDROID=0.0.0
MIN_CLIENT_WEB=0.0.0
AGE_PUBLIC_KEY=age1ra0rk40y79kvyzezpla2duw38nj8jjueg9uupqgvepzvz52fwc3sx87a3z
RCLONE_REMOTE=r2:wallet/pg
BACKUP_PREFIX=prod
APP_VERSION=v2.0.0
SENTRY_DSN=
# Phase 1C shim for the v1 Android app: the old API_TOKEN and the owner's personal space id (from the import output).
LEGACY_API_TOKEN=
LEGACY_SPACE_ID=
