# Copy to /home/deploy/opt/wallet/deploy/.env.staging on the VPS, fill in, chmod 600.
# Never commit the filled-in file — `.env.staging` is gitignored.
NODE_ENV=production
# Selects which env file the api service loads. Must name this file, because
# compose concatenates env_file lists across overlays (see deploy/compose.yml).
ENV_FILE=.env.staging
POSTGRES_PASSWORD=<openssl rand -hex 24>
BETTER_AUTH_SECRET=<openssl rand -hex 32>
BETTER_AUTH_URL=https://wallet-staging.samtama.lol
TRUSTED_ORIGINS=https://wallet-staging.samtama.lol
MIN_CLIENT_ANDROID=0.0.0
MIN_CLIENT_WEB=0.0.0
API_PORT=8082
AGE_PUBLIC_KEY=age1ra0rk40y79kvyzezpla2duw38nj8jjueg9uupqgvepzvz52fwc3sx87a3z
RCLONE_REMOTE=r2:wallet/pg
APP_VERSION=staging
# Sentry server DSN (staging). Leave blank to disable Sentry.
SENTRY_DSN=
# Backup schedule for the sidecar's crond. Default is 02:00 UTC daily; set it to
# "* * * * *" for one minute to prove the scheduled path, then put it back.
#BACKUP_CRON=0 2 * * *
